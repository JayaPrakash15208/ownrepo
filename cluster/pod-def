# hello-app-v2.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello-app-v2
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hello-app-v2
  template:
    metadata:
      labels:
        app: hello-app-v2
    spec:
      containers:
        - name: hello-app
          image: hashicorp/http-echo
          args:
            - "-text=Hello v2!"
          ports:
            - containerPort: 5678
---
apiVersion: v1
kind: Service
metadata:
  name: hello-app-v2
spec:
  selector:
    app: hello-app-v2
  ports:
    - port: 80
      targetPort: 5678
